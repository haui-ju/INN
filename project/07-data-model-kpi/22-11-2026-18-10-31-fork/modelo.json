  "kpis": [
    {
      "codigo": "KPI-01",
      "nombre": "Calidad de datos del ETL",
      "formula": "Registros válidos entre registros cargados",
      "medida": "% Registros válidos",
      "origen": [
        "fPedidos.registro_valido",
        "fPedidos.registro_total"
      ],
      "meta": "98 % o más",
      "frecuencia": "Por carga",
      "objetivo": "OE-01",
      "decision": "Confiar en las cifras del dashboard antes de decidir"
    },
    {
      "codigo": "KPI-02",
      "nombre": "Margen de contribución por canal y producto",
      "formula": "(Venta bruta menos comisión menos costo estimado) entre venta bruta, por canal y producto",
      "medida": "Margen de contribución %",
      "origen": [
        "fPedidos.venta_bruta",
        "fPedidos.comision",
        "fPedidos.costo_estimado",
        "dCanal.canal",
        "dProducto.producto"
      ],
      "meta": "Pendiente",
      "frecuencia": "Mensual",
      "objetivo": "OE-02",
      "decision": "Fijar precios diferenciados por canal"
    },
    {
      "codigo": "KPI-03",
      "nombre": "Margen neto global",
      "formula": "(Venta bruta menos comisión, costo estimado y costo operativo) entre venta bruta",
      "medida": "Margen neto %",
      "origen": [
        "fPedidos.venta_bruta",
        "fPedidos.comision",
        "fPedidos.costo_estimado",
        "fPedidos.costo_operativo"
      ],
      "meta": "12 % o más",
      "frecuencia": "Mensual",
      "objetivo": "OE-02",
      "decision": "Fijar precios diferenciados por canal"
    },
    {
      "codigo": "KPI-04",
      "nombre": "Porcentaje de merma por turno",
      "formula": "Pollos de merma entre pollos preparados, por turno",
      "medida": "% Merma",
      "origen": [
        "fProduccion.pollos_merma",
        "fProduccion.pollos_preparados",
        "dTurno.turno"
      ],
      "meta": "3 % o menos",
      "frecuencia": "Diaria",
      "objetivo": "OE-03",
      "decision": "Definir cuántos pollos preparar en cada turno y día de la semana"
    },
    {
      "codigo": "KPI-05",
      "nombre": "Precisión del pronóstico de demanda",
      "formula": "Error porcentual absoluto medio entre los pollos vendidos y los pronosticados por día y turno",
      "medida": "Error del pronóstico %",
      "origen": [
        "fProduccion.pollos_vendidos",
        "dCalendario.fecha",
        "dTurno.turno"
      ],
      "meta": "15 % o menos",
      "frecuencia": "Semanal",
      "objetivo": "OE-03",
      "decision": "Definir cuántos pollos preparar en cada turno y día de la semana, y asignar el personal según la franja horaria"
    },
    {
      "codigo": "KPI-06",
      "nombre": "Precio promedio del pollo vivo por kilogramo",
      "formula": "Promedio del precio diario por kilogramo en el periodo",
      "medida": "Precio pollo vivo",
      "origen": [
        "fPrecioInsumo.precio_kg",
        "dCalendario.fecha"
      ],
      "meta": "Pendiente",
      "frecuencia": "Semanal",
      "objetivo": "OE-04",
      "decision": "Anticipar compras y ajustar precios ante subidas del pollo vivo"
    },
    {
      "codigo": "KPI-07",
      "nombre": "KPI con meta en el dashboard",
